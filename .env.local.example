# Contact Form Email Configuration
# Use one of these options:

# Option 1: Webhook Service (e.g., Make, Zapier, custom service)
CONTACT_WEBHOOK_URL=https://your-webhook-url-here.com

# Option 2: SMTP Service (Gmail, Outlook, custom SMTP)
# For Gmail: Generate App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Alternative SMTP Providers:
# Yahoo Mail: SMTP_HOST=smtp.mail.yahoo.com, SMTP_PORT=587
# Outlook: SMTP_HOST=smtp-mail.outlook.com, SMTP_PORT=587
